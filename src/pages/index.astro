---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>Hi, I'm Tushita 👋</h1>
			<p>
				I'm a backend software developer who loves building fast, reliable systems. This is where I
				write about the side projects I tinker with, how I think software gets built well, and the
				books and blog posts I'm chewing on. I also intend to write about the world as I observe
				it.
			</p>
			<p>
				Come take a look at <a href="/series">my blogs</a>. You can also read <a href="/about">more about me</a> or follow along via <a href="/rss.xml">RSS</a>.
			</p>
		</main>
		<Footer />
	</body>
</html>
