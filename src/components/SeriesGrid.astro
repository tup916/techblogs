---
import { getCollection } from 'astro:content';
import { SERIES, TYPE_ORDER, TYPES } from '../data/series';
import BookList from './BookList.astro';

const posts = await getCollection('blog');
const counts: Record<string, number> = {};
for (const post of posts) {
	if (post.data.series) counts[post.data.series] = (counts[post.data.series] ?? 0) + 1;
}
const readingSlugs = Object.entries(SERIES)
	.filter(([, s]) => s.type === 'reading')
	.map(([slug]) => slug);
const reviews = posts.filter((p) => p.data.series && readingSlugs.includes(p.data.series));
const groups = TYPE_ORDER.map((type) => ({
	type,
	...TYPES[type],
	items: Object.entries(SERIES)
		.filter(([, s]) => s.type === type)
		.map(([slug, s]) => ({ slug, ...s, count: counts[slug] ?? 0 })),
})).filter((g) => g.items.length > 0);
---

{
	groups.map((group) => (
		<section class="group">
			<h2>
				<span aria-hidden="true">{group.emoji}</span> {group.label}
			</h2>
			{group.type === 'reading' ? (
				<BookList posts={reviews} />
			) : (
			<div class="tiles">
				{group.items.map((s) => (
					<a
						class="tile"
						href={`/series/${s.slug}/`}
						style={`--tint: ${group.tint}; --border: ${group.border};`}
					>
						<span class="emoji" aria-hidden="true">
							{s.emoji}
						</span>
						<span class="name">{s.title}</span>
						<span class="blurb">{s.blurb}</span>
						<span class="count">
							{s.count === 0 ? 'Coming soon' : `${s.count} post${s.count === 1 ? '' : 's'}`}
						</span>
					</a>
				))}
			</div>
			)}
		</section>
	))
}

<style>
	.group {
		margin-bottom: 2em;
	}
	.group h2 {
		font-size: 1.2em;
		color: rgb(var(--gray-dark));
		margin-bottom: 0.75em;
	}
	.tiles {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
		gap: 1em;
	}
	.tile {
		display: flex;
		flex-direction: column;
		gap: 0.35em;
		padding: 1.1em 1.2em;
		background: var(--tint);
		border: 1px solid var(--border);
		border-radius: 14px;
		text-decoration: none;
		color: rgb(var(--gray-dark));
		transition:
			transform 0.15s ease,
			box-shadow 0.15s ease;
	}
	.tile:hover {
		transform: translateY(-3px);
		box-shadow: var(--box-shadow);
	}
	.emoji {
		font-size: 2em;
		line-height: 1;
	}
	.name {
		font-size: 1.15em;
		font-weight: 700;
		line-height: 1.25;
		color: rgb(var(--black));
	}
	.blurb {
		font-size: 0.8em;
		line-height: 1.45;
		color: rgb(var(--gray-dark));
	}
	.count {
		margin-top: auto;
		padding-top: 0.5em;
		font-size: 0.7em;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: rgb(var(--gray));
	}
</style>
